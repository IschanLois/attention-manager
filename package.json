{
  "name": "attention-manager",
  "version": "0.1.0",
  "description": "A terminal UI that shows which Claude Code sessions need you and jumps to the terminal running them.",
  "license": "MIT",
  "type": "module",
  "author": "christianlois.olo@gmail.com",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/IschanLois/app-builders-hackathon.git"
  },
  "keywords": [
    "claude",
    "claude-code",
    "hooks",
    "tui",
    "terminal",
    "tmux",
    "attention",
    "cli"
  ],
  "bin": {
    "attention": "dist/cli/main.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=24"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "attention": "node src/cli/main.ts",
    "receiver": "node src/cli/main.ts receiver",
    "clean": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\"",
    "build": "pnpm clean && tsc -p tsconfig.build.json && pnpm chmod-bins",
    "chmod-bins": "node -e \"for (const f of ['dist/cli/main.js','dist/hook/main.js']) require('node:fs').chmodSync(f, 0o755)\"",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "verify": "pnpm lint && pnpm typecheck && pnpm build && pnpm test && npm pack --dry-run",
    "prepack": "pnpm build",
    "prepublishOnly": "pnpm verify"
  },
  "dependencies": {
    "@clack/prompts": "1.8.1",
    "ink": "7.1.1",
    "react": "19.3.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/node": "^24.19.1",
    "@types/react": "^19",
    "eslint": "^9",
    "eslint-plugin-react-hooks": "7.1.1",
    "ink-testing-library": "4.0.0",
    "typescript": "^5",
    "typescript-eslint": "8.71.0",
    "vitest": "^5.0.3"
  },
  "packageManager": "pnpm@11.6.0"
}
