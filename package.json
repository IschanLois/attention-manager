{
  "name": "attention-manager",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:dashboard": "next dev -H 127.0.0.1",
    "dev:receiver": "node --env-file-if-exists=.env --no-warnings=ExperimentalWarning --watch src/receiver/main.ts",
    "receiver": "node --env-file-if-exists=.env --no-warnings=ExperimentalWarning src/receiver/main.ts",
    "build": "next build",
    "start": "next start -H 127.0.0.1",
    "hooks:install": "node --no-warnings=ExperimentalWarning scripts/setup-hooks.ts install",
    "hooks:uninstall": "node --no-warnings=ExperimentalWarning scripts/setup-hooks.ts uninstall",
    "doctor": "node --env-file-if-exists=.env --no-warnings=ExperimentalWarning scripts/doctor.ts",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "next": "16.4.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^24.19.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.0",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^5.0.3"
  },
  "packageManager": "pnpm@11.6.0"
}
