# attention (Claude Code Attention Manager) environment overrides.
# Nothing here is required: `attention setup` writes config.json with the answers that
# matter, and every other setting has a default. Export any of these to override them.
# Never put real secrets in this file; the ingest token lives in the config directory.

# Receiver bind host and port (loopback only; port defaults to config receiver.port, 4318)
RECEIVER_HOST=127.0.0.1
RECEIVER_PORT=4318
# Where the hook forwarder and the CLI reach the receiver (derived from the port when unset)
# ATTENTION_RECEIVER_URL=http://127.0.0.1:4318

# Data locations (defaults: XDG dirs on Linux, ~/Library on macOS)
# ATTENTION_CONFIG_DIR=/path/to/config
# ATTENTION_STATE_DIR=/path/to/state
# DATABASE_PATH=/path/to/attention.db
# INGEST_TOKEN_PATH=/path/to/ingest-token
# CLAUDE_SETTINGS_PATH=~/.claude/settings.json

# Local model runtime (Ollama-compatible) and model name (defaults from config.json)
# OLLAMA_URL=http://127.0.0.1:11434
# OLLAMA_MODEL=qwen3:1.7b
CLASSIFY_TIMEOUT_MS=15000

# Sessions with no events for this long are flagged stale (milliseconds)
STALE_AFTER_MS=600000
# Bounded per-session event history
EVENT_HISTORY_LIMIT=50
# Identical events inside this window are dropped (milliseconds, 0 disables)
DEDUPE_WINDOW_MS=5000
# Events per minute per session and overall
RATE_LIMIT_PER_SESSION=120
RATE_LIMIT_GLOBAL=1200
# Maximum accepted request body in bytes
MAX_BODY_BYTES=262144
# Delete ended sessions and their events after this many days
RETENTION_DAYS=7
# Maximum number of tracked sessions (oldest ended ones are evicted first)
MAX_SESSIONS=1000
# Set to 0 to stop capturing prompt/command/narration snippets for task severity
CAPTURE_TASK_CONTEXT=1
# Seconds the hook forwarder waits for the receiver
ATTENTION_HOOK_TIMEOUT=2
# Logging level: error | warn | info | debug
LOG_LEVEL=info
# Disable colour in the CLI and TUI
# NO_COLOR=1
