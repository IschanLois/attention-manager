# Attention Manager configuration.
# Copy this file to .env (cp env.example .env) and adjust as needed.

# Event receiver bind host and port (loopback only by default)
RECEIVER_HOST=127.0.0.1
RECEIVER_PORT=4318

# Dashboard (Next.js) port and the receiver URL it proxies to
PORT=3000
RECEIVER_URL=http://127.0.0.1:4318

# SQLite database file (":memory:" for ephemeral)
DATABASE_PATH=./data/attention.db

# Local model runtime (Ollama-compatible) and model name
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen2.5:1.5b

# Classification timeout in milliseconds
CLASSIFY_TIMEOUT_MS=8000

# Sessions with no events for this long are flagged stale (milliseconds)
STALE_AFTER_MS=600000

# Bounded per-session event history
EVENT_HISTORY_LIMIT=50

# Maximum accepted request body in bytes
MAX_BODY_BYTES=262144

# Logging level: error | warn | info | debug
LOG_LEVEL=info

# Delete ended sessions and their events after this many days
RETENTION_DAYS=7
# Maximum number of tracked sessions (oldest ended ones are evicted first)
MAX_SESSIONS=1000
# Set to 1 to run the receiver without an ingest token (not recommended)
ATTENTION_ALLOW_NO_TOKEN=0
# Disable Next.js telemetry
NEXT_TELEMETRY_DISABLED=1
